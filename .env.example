# Server bind address for host-based local runs.
SERVICE_HOST=127.0.0.1
HTTP_PORT=3000

# Core dependencies.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/likes_service
REDIS_URL=redis://127.0.0.1:6379/

# Fixed-window rate limits per minute.
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=1000

# Redis TTL for cached content validation results.
CACHE_TTL_CONTENT_VALIDATION_SECS=3600

# Circuit breaker settings.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=30
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=30

# Internal/local dependency URLs. In Docker these point to the app service.
PROFILE_API_URL=http://127.0.0.1:3000
CONTENT_API_POST_URL=http://127.0.0.1:3000
CONTENT_API_BONUS_HUNTER_URL=http://127.0.0.1:3000
CONTENT_API_TOP_PICKS_URL=http://127.0.0.1:3000
