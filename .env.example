# Server bind address for host-based local runs.
SERVICE_HOST=127.0.0.1
HTTP_PORT=8080

# Core dependencies.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/likes_service
READ_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/likes_service
REDIS_URL=redis://127.0.0.1:6379/

# Logging.
LOG_LEVEL=info
RUST_LOG=likes_service=info

# Database pool settings.
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=5
REDIS_POOL_SIZE=10

# Fixed-window rate limits per minute.
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=1000

# Redis TTLs for cached reads.
CACHE_TTL_LIKE_COUNTS_SECS=300
CACHE_TTL_CONTENT_VALIDATION_SECS=3600
CACHE_TTL_USER_STATUS_SECS=60

# Circuit breaker settings.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=30
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=30

# Graceful shutdown.
SHUTDOWN_TIMEOUT_SECS=30

# SSE.
SSE_HEARTBEAT_INTERVAL_SECS=15

# Leaderboard.
LEADERBOARD_REFRESH_INTERVAL_SECS=60

# Internal/local dependency URLs. In Docker these point to the app service.
PROFILE_API_URL=http://127.0.0.1:8080
CONTENT_API_POST_URL=http://127.0.0.1:8080
CONTENT_API_BONUS_HUNTER_URL=http://127.0.0.1:8080
CONTENT_API_TOP_PICKS_URL=http://127.0.0.1:8080
